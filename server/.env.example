PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://admin:admin123@localhost:27017/Secure-Bridge?authSource=admin
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
REDIS_URL=redis://localhost:6380
EMAIL_USER=
EMAIL_PASS=
ENABLE_MCP=false
OUTBOUND_ALLOWLIST=
MCP_TRANSPORT=streamable-http
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8787
MCP_SERVER_URL=http://127.0.0.1:8787/mcp
# FHE backend mode: "mock" = honest AES-256-GCM stub (always starts);
# "fhe" = real OpenFHE WASM (BFV) with automatic stub fallback if the
# WASM module cannot load. In "fhe" mode chat messages are additionally
# encrypted at rest (AES-256-GCM keyed from ENCRYPTION_KEY via HKDF) and
# chat-history context selection is scored homomorphically (BFV ciphertexts).
ENCRYPTION_MODE=mock
# Optional: override the OpenFHE WASM artifact locations (defaults resolve
# to server/fhe/).
# FHE_WASM_PATH=
# FHE_JS_PATH=

# --- MCP (Model Context Protocol) ---
# Base URL the MCP server uses to call back into this Express API
EXPRESS_API_BASE_URL=http://127.0.0.1:8000
# HMAC secret used to sign the chatting user's id for user-scoped MCP tool
# calls (search_project_context). Generate with: openssl rand -hex 32
MCP_SERVICE_TOKEN=change-me-to-a-long-random-hex
